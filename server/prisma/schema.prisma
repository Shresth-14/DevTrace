generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String?  @unique
  name             String?
  githubId         BigInt   @unique
  githubUsername   String
  githubAvatarUrl  String?
  githubProfileUrl String?
  githubUserType   String   @default("User")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  token         GithubAccountToken?
  installations GithubInstallation[]
  projects      Project[]

  @@index([githubUsername])
}

model GithubAccountToken {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model GithubInstallation {
  id                  String   @id @default(cuid())
  installationId      BigInt
  accountLogin        String
  accountId           BigInt
  accountType         String // "User" or "Organization"
  accountAvatarUrl    String?
  targetType          String? // "User" or "Organization"
  repositorySelection String   @default("all") // "all" or "selected"
  status              String   @default("active") // "active", "suspended", "deleted"
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projects Project[]

  @@unique([userId, installationId])
  @@index([accountLogin])
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // GitHub repository association
  githubRepoId       BigInt
  githubRepoFullName String // "owner/repo"
  githubRepoName     String // "repo"
  githubRepoOwner    String // "owner"
  githubRepoUrl      String
  defaultBranch      String  @default("main")
  isPrivate          Boolean @default(false)
  primaryLanguage    String?

  installationId String?
  installation   GithubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  // Synchronization state (per-resource checkpoints live in syncCursor)
  syncStatus   String    @default("never") // never | queued | running | completed | partial | failed
  lastSyncedAt DateTime?
  syncCursor   Json?

  // AI decision extraction state (separate from GitHub sync state)
  aiStatus        String    @default("pending") // pending | running | completed | partial | failed | not_configured
  lastExtractedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncJobs           SyncJob[]
  extractionRuns     ExtractionRun[]
  extractionUnits    ExtractionUnit[]
  decisions          Decision[]
  threadReferences   ThreadReference[]
  issues             GithubIssue[]
  issueComments      GithubIssueComment[]
  pullRequests       GithubPullRequest[]
  prComments         GithubPrComment[]
  prReviews          GithubPrReview[]
  reviewComments     GithubReviewComment[]
  prFiles            GithubPrFile[]
  prCommits          GithubPrCommit[]
  commits            GithubCommit[]
  discussions        GithubDiscussion[]
  discussionComments GithubDiscussionComment[]
  repoFiles          GithubRepoFile[]

  @@unique([userId, githubRepoId])
  @@index([slug])
  @@index([userId])
  @@index([githubRepoFullName])
}

// ---------------------------------------------------------------------------
// GitHub ingestion. Raw source content only; AI interpretation lives elsewhere.
// All rows are keyed by GitHub's stable IDs / numbers so repeated syncs upsert.
// ---------------------------------------------------------------------------

model SyncJob {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trigger    String    @default("initial") // initial | manual
  mode       String    @default("full") // full | incremental
  status     String    @default("running") // running | completed | partial | failed
  // { [resource]: { status: "ok" | "error" | "skipped", count: number, error?: string } }
  resources  Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([projectId, startedAt])
}

model GithubIssue {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId    BigInt
  number      Int
  title       String
  body        String?
  authorLogin String?
  state       String
  stateReason String?
  labels      Json
  assignees   Json
  url         String
  createdAtGh DateTime
  updatedAtGh DateTime
  closedAtGh  DateTime?

  comments GithubIssueComment[]

  /// Why this thread was imported: open (current work), referenced (linked from current
  /// work), legacy (imported by an earlier version without a reason)
  fetchReason String @default("legacy")

  @@unique([projectId, number])
  @@unique([projectId, githubId])
  @@index([projectId, updatedAtGh])
  @@index([projectId, state])
}

model GithubIssueComment {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId    BigInt
  issueNumber Int
  issue       GithubIssue @relation(fields: [projectId, issueNumber], references: [projectId, number], onDelete: Cascade)
  body        String
  authorLogin String?
  url         String
  createdAtGh DateTime
  updatedAtGh DateTime

  @@unique([projectId, githubId])
  @@index([projectId, issueNumber])
}

model GithubPullRequest {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId       BigInt
  number         Int
  title          String
  body           String?
  authorLogin    String?
  state          String
  isDraft        Boolean   @default(false)
  baseRef        String
  headRef        String
  baseSha        String
  headSha        String
  mergeCommitSha String?
  labels         Json
  reviewers      Json
  url            String
  createdAtGh    DateTime
  updatedAtGh    DateTime
  closedAtGh     DateTime?
  mergedAtGh     DateTime?

  comments       GithubPrComment[]
  reviews        GithubPrReview[]
  reviewComments GithubReviewComment[]
  files          GithubPrFile[]
  commits        GithubPrCommit[]

  fetchReason String @default("legacy") // open | referenced | legacy (see GithubIssue)

  @@unique([projectId, number])
  @@unique([projectId, githubId])
  @@index([projectId, updatedAtGh])
  @@index([projectId, state])
}

// General PR conversation comments (not inline, not review submissions)
model GithubPrComment {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId    BigInt
  prNumber    Int
  pullRequest GithubPullRequest @relation(fields: [projectId, prNumber], references: [projectId, number], onDelete: Cascade)
  body        String
  authorLogin String?
  url         String
  createdAtGh DateTime
  updatedAtGh DateTime

  @@unique([projectId, githubId])
  @@index([projectId, prNumber])
}

// Review submissions (APPROVED / CHANGES_REQUESTED / COMMENTED / DISMISSED)
model GithubPrReview {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId      BigInt
  prNumber      Int
  pullRequest   GithubPullRequest @relation(fields: [projectId, prNumber], references: [projectId, number], onDelete: Cascade)
  reviewerLogin String?
  body          String?
  state         String
  commitSha     String?
  url           String
  submittedAt   DateTime?

  @@unique([projectId, githubId])
  @@index([projectId, prNumber])
}

// Inline diff comments, with thread structure from GraphQL reviewThreads
model GithubReviewComment {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubId       BigInt
  prNumber       Int
  pullRequest    GithubPullRequest @relation(fields: [projectId, prNumber], references: [projectId, number], onDelete: Cascade)
  reviewGithubId BigInt?
  inReplyToId    BigInt?
  threadId       String?
  isResolved     Boolean?
  body           String
  authorLogin    String?
  path           String
  line           Int?
  originalLine   Int?
  diffHunk       String?
  commitSha      String?
  url            String
  createdAtGh    DateTime
  updatedAtGh    DateTime

  @@unique([projectId, githubId])
  @@index([projectId, prNumber])
  @@index([projectId, threadId])
}

model GithubPrFile {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prNumber         Int
  pullRequest      GithubPullRequest @relation(fields: [projectId, prNumber], references: [projectId, number], onDelete: Cascade)
  filename         String
  previousFilename String?
  status           String
  additions        Int
  deletions        Int
  changes          Int
  blobSha          String?
  patch            String? // null when GitHub omits it (binary / very large diffs)
  headSha          String?

  @@unique([projectId, prNumber, filename])
  @@index([projectId, filename])
}

model GithubPrCommit {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prNumber    Int
  pullRequest GithubPullRequest @relation(fields: [projectId, prNumber], references: [projectId, number], onDelete: Cascade)
  sha         String

  @@unique([projectId, prNumber, sha])
  @@index([projectId, sha])
}

model GithubCommit {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sha            String
  message        String
  authorName     String?
  authorEmail    String?
  authorLogin    String?
  committerName  String?
  committerLogin String?
  authoredAt     DateTime?
  committedAt    DateTime?
  url            String

  @@unique([projectId, sha])
  @@index([projectId, committedAt])
}

model GithubDiscussion {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubNodeId        String
  number              Int
  title               String
  body                String?
  category            String?
  authorLogin         String?
  isAnswered          Boolean  @default(false)
  answerCommentNodeId String?
  url                 String
  createdAtGh         DateTime
  updatedAtGh         DateTime

  comments GithubDiscussionComment[]

  @@unique([projectId, number])
  @@unique([projectId, githubNodeId])
}

model GithubDiscussionComment {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubNodeId     String
  discussionNumber Int
  discussion       GithubDiscussion @relation(fields: [projectId, discussionNumber], references: [projectId, number], onDelete: Cascade)
  parentNodeId     String? // set for nested replies
  body             String
  authorLogin      String?
  isAnswer         Boolean          @default(false)
  url              String
  createdAtGh      DateTime
  updatedAtGh      DateTime

  @@unique([projectId, githubNodeId])
  @@index([projectId, discussionNumber])
}

model GithubRepoFile {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  type      String // blob | tree
  sha       String
  size      Int?
  ref       String

  @@unique([projectId, path])
}

// ---------------------------------------------------------------------------
// AI-generated interpretation. Kept apart from the raw source tables above;
// evidence rows point back at real imported records, never at model output.
// ---------------------------------------------------------------------------

model ExtractionRun {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String    @default("running") // running | completed | partial | failed
  phase          String    @default("analyzing") // analyzing | validating | saving
  model          String
  version        String
  force          Boolean   @default(false)
  unitsTotal     Int       @default(0)
  unitsDone      Int       @default(0)
  unitsFailed    Int       @default(0)
  decisionsSaved Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([projectId, startedAt])
}

// One analysable thread (issue / PR / discussion). The content hash lets us skip
// threads that have not changed since they were last analysed.
model ExtractionUnit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String // issue | pull_request | discussion
  number      Int
  contentHash String
  status      String // done | failed
  model       String
  version     String
  error       String?
  processedAt DateTime @default(now())

  @@unique([projectId, kind, number])
}

model Decision {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Stable per-project number shown as DEC-001
  seq           Int
  /// Normalised-title hash used to merge the same decision found in several threads
  fingerprint   String
  title         String
  summary       String
  status        String // accepted | rejected | proposed | withdrawn | unresolved
  reasoning     Json // [{ category, explanation }]
  openQuestions String?
  participants  Json // logins seen in the evidence
  confidence    Float?
  model         String
  version       String
  decidedAt     DateTime? // date of the latest piece of evidence
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  evidence     DecisionEvidence[]
  alternatives DecisionAlternative[]
  codeLinks    DecisionCodeLink[]

  @@unique([projectId, seq])
  @@unique([projectId, fingerprint])
  @@index([projectId, status])
}

model DecisionEvidence {
  id           String    @id @default(cuid())
  decisionId   String
  decision     Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// issue | issue_comment | pull_request | pr_comment | review | review_comment | discussion | discussion_comment | commit
  sourceType   String
  /// Natural key of the imported record (issue number, GitHub comment id, node id, sha)
  sourceKey    String
  /// Issue / PR / discussion the record belongs to
  threadKind   String
  threadNumber Int
  author       String?
  quote        String
  url          String
  occurredAt   DateTime?

  alternativeLinks AlternativeEvidence[]

  @@unique([decisionId, sourceType, sourceKey])
  @@index([decisionId])
}

model DecisionAlternative {
  id            String   @id @default(cuid())
  decisionId    String
  decision      Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  title         String
  proposedBy    String?
  reason        String?
  status        String // rejected | withdrawn | unresolved | proposed
  chosenInstead String?

  evidence AlternativeEvidence[]

  @@unique([decisionId, title])
}

model AlternativeEvidence {
  alternativeId String
  alternative   DecisionAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      DecisionEvidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([alternativeId, evidenceId])
}

model DecisionCodeLink {
  id           String   @id @default(cuid())
  decisionId   String
  decision     Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  path         String
  previousPath String?
  /// direct = a source record names or changes the file; inferred = model-suggested and found in the repo tree
  relationship String // direct | inferred
  basis        String // pr_file | review_comment | model_inferred
  description  String?
  commitSha    String?
  line         Int?
  prNumber     Int?

  @@unique([decisionId, path, basis])
  @@index([decisionId])
}

/// Explicit links between threads (issue/PR A mentions or closes B). Only relationships
/// GitHub or the text states are stored; similar titles are never turned into a link.
model ThreadReference {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromKind     String // issue | pull_request
  fromNumber   Int
  toNumber     Int
  /// reference_in_body | reference_in_comment | closing_reference
  basis        String
  /// direct = stated by GitHub metadata or by an explicit #N / URL in the text
  relationship String   @default("direct")
  createdAt    DateTime @default(now())

  @@unique([projectId, fromKind, fromNumber, toNumber, basis])
  @@index([projectId, toNumber])
}
